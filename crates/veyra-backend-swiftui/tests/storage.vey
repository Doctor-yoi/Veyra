enum Priority { low, normal, high }

entity Todo @persistent {
  id: String @primaryKey
  title: String
  note: String?
  done: Bool
  priority: Priority
  dueAt: Date @indexed
  estimate: Double
}

store TodoStore for Todo {
  query pending() -> Stream<List<Todo>> {
    where !done
    orderBy dueAt asc, title asc
  }

  query search(text: String, minimum: Priority) -> Stream<List<Todo>> {
    where title.contains(text) && priority == minimum || note != nil
    limit 20
  }

  query urgent(before: Date) -> List<Todo> {
    where dueAt < before && priority == .high && estimate >= 1
    orderBy dueAt desc
  }

  query byTitle(name: String) -> Todo? {
    where title == name
  }
}

screen Todos {
  inject todos: TodoStore

  state {
    items: List<Todo> = []
  }

  actions {
    load() async
    toggle(id: String) async
  }

  lifecycle {
    onAppear: load
  }

  view {
    List(items, key: .id) { task in
      Row {
        Text(task.title)
        Spacer()
        Text(task.done ? "✓" : "")
      }
      .onTap(toggle(task.id))
    }
  }
}
