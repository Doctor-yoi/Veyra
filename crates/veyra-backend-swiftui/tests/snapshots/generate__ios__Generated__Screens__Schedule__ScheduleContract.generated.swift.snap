// This file is generated by Veyra, do not edit it manually

import Foundation

/// View model contract of Schedule, the only type the view depends on
@MainActor
protocol ScheduleViewModelContract: AnyObject {
    var state: ScheduleState { get }
    var onEffect: ((ScheduleEffect) -> Void)? { get set }

    func setQuery(_ value: String)
    func setVolume(_ value: Double)
    func setNotify(_ value: Bool)
    func setPassword(_ value: String)

    func refresh() async
    func openCourse(id: String)
    func stop()
}

/// One-off events emitted by the Schedule view model
enum ScheduleEffect: Sendable {
    case navigateToDetail(id: String)
    case showToast(message: String)
    case close
}

extension ScheduleViewModelContract {
    /// Sends an effect to the root view
    func emit(_ effect: ScheduleEffect) {
        onEffect?(effect)
    }
}

/// Default setters write state directly, override them in the view model to validate input
extension ScheduleViewModelContract {
    func setQuery(_ value: String) {
        state.query = value
    }

    func setVolume(_ value: Double) {
        state.volume = value
    }

    func setNotify(_ value: Bool) {
        state.notify = value
    }

    func setPassword(_ value: String) {
        state.password = value
    }
}
