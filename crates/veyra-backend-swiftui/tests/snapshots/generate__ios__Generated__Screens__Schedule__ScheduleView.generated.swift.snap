// This file is generated by Veyra, do not edit it manually

import SwiftUI

struct ScheduleView<ViewModel: ScheduleViewModelContract>: View {
    let viewModel: ViewModel

    var body: some View {
        ScrollView {
            VStack(alignment: .leading, spacing: 16.0) {
                Text(L10n.scheduleTitle)
                    .font(.title)
                    .padding(8.0)
                Text(L10n.scheduleCount(count: viewModel.state.count, filter: viewModel.state.subtitle))
                    .foregroundStyle(.secondary)
                TextField(L10n.scheduleSearch, text: Binding(get: { viewModel.state.query }, set: { viewModel.setQuery($0) }))
                SearchBar(text: Binding(get: { viewModel.state.query }, set: { viewModel.setQuery($0) }), placeholder: "搜索")
                ShareLink(L10n.scheduleShare, item: viewModel.state.query)
                Text(verbatim: viewModel.state.query).monospaced()
                Button("Native") { Task { await viewModel.refresh() } }
                #if DEBUG
                Text(verbatim: "debug build")
                #else
                Text(verbatim: "release build")
                #endif
                if #available(iOS 26, *) {
                    Text(verbatim: "glass")
                        .glassEffect(.regular, in: .capsule)
                } else {
                    Text(verbatim: "plain")
                }
                Menu(L10n.scheduleMore) {
                    Button(L10n.scheduleRefresh) {
                        Task { await viewModel.refresh() }
                    }
                }
                Section(content: {
                    Text(verbatim: "内容")
                }, header: {
                    Text(verbatim: "头部")
                })
                Stepper(String("音量"), value: Binding(get: { viewModel.state.volume }, set: { viewModel.setVolume($0) }), step: 0.1)
                Link(String("Veyra"), destination: URL(string: "https://github.com/Doctor-yoi/Veyra")!)
                ContentUnavailableView(L10n.scheduleNone, systemImage: "tray")
                Text(viewModel.state.query)
                    .textInputAutocapitalization(.never)
                    .foregroundStyle(.tint)
                    .refreshable(action: { await viewModel.refresh() })
                    .navigationTitle(L10n.scheduleTitle)
                Text(verbatim: "tag")
                    #if DEBUG
                    .padding(4.0)
                    #endif
                    .background(Color.blue)
                SecureField(String("密码"), text: Binding(get: { viewModel.state.password }, set: { viewModel.setPassword($0) }))
                Toggle(L10n.scheduleNotify, isOn: Binding(get: { viewModel.state.notify }, set: { viewModel.setNotify($0) }))
                Slider(value: Binding(get: { viewModel.state.volume }, set: { viewModel.setVolume($0) }), in: 0.0...1.0)
                Text(viewModel.state.volume.formatted(.percent))
                Text(L10n.scheduleItems(count: viewModel.state.count))
                Button(L10n.scheduleRefresh) {
                    Task { await viewModel.refresh() }
                }
                .disabled(!viewModel.state.canRefresh)
                .frame(maxWidth: .infinity)
                if viewModel.state.isRefreshing {
                    ProgressView()
                } else if viewModel.state.items.isEmpty {
                    Text(L10n.scheduleEmpty)
                } else {
                    ForEach(viewModel.state.items, id: \.id) { course in
                        HStack(alignment: .center) {
                            Image("book")
                            Text(course.name)
                                .font(.headline)
                            Text(course.credits.formatted(.number))
                            Text(course.startsAt.formatted(date: .numeric, time: .shortened))
                            Text(course.credits.formatted(.currency(code: "CNY")))
                            Spacer()
                            Text(course.teacher ?? "-")
                                .foregroundStyle(Color.gray)
                        }
                        .padding()
                        .background(Color.accentColor)
                        .onTapGesture { viewModel.openCourse(id: course.id) }
                        .accessibilityLabel(course.name)
                    }
                }
                ForEach(viewModel.state.items, id: \.id) { course in
                    CourseCard(course: course, note: nil, onTap: { viewModel.openCourse(id: course.id) })
                }
                Divider()
                ZStack(alignment: .bottomTrailing) {
                    Text(verbatim: "v1.0")
                        .opacity(viewModel.state.isRefreshing ? 0 : 1)
                }
            }
        }
    }
}
