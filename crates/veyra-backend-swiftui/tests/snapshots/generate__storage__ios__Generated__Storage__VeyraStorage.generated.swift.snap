    let todoStore: any TodoStore

    init(context: ModelContext) {
        todoStore = SwiftDataTodoStore(context: context)
    }
}

/// Holds main actor values inside sendable closures
private final class VeyraMainActorBox<Value>: @unchecked Sendable {
    let value: Value

    init(_ value: Value) {
        self.value = value
    }
}

/// Re-runs a fetch whenever the model context saves
@MainActor
enum VeyraObservation {
    static func stream<Value: Sendable>(context: ModelContext, fetch: @escaping (ModelContext) -> Value) -> AsyncStream<Value> {
        AsyncStream { continuation in
            continuation.yield(fetch(context))
            let source = VeyraMainActorBox((context, fetch))
            let token = NotificationCenter.default.addObserver(forName: ModelContext.didSave, object: nil, queue: .main) { _ in
                MainActor.assumeIsolated {
                    _ = continuation.yield(source.value.1(source.value.0))
                }
            }
            let observer = VeyraMainActorBox(token)
            continuation.onTermination = { _ in
                NotificationCenter.default.removeObserver(observer.value)
            }
        }
    }
}
