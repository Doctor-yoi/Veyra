// This file is generated by Veyra, do not edit it manually

import SwiftUI

/// Entry point of Todos, creates the view model and injects dependencies
struct TodosRoot: View {
    @Environment(\.veyraDependencies) private var dependencies
    @State private var viewModel: TodosViewModel?

    var body: some View {
        if let viewModel {
            TodosView(viewModel: viewModel)
                .task { await viewModel.load() }
        } else {
            Color.clear.onAppear {
                guard let dependencies else {
                    assertionFailure("VeyraDependencies is missing, call veyraDependencies(_:) on an ancestor view")
                    return
                }
                viewModel = TodosViewModel(todos: dependencies.todoStore)
            }
        }
    }
}
