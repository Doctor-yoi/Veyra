// This file is generated by Veyra, do not edit it manually

import Foundation
import SwiftData

/// Persistent storage of `Todo`, use the value type outside the store
@Model
final class TodoEntity {
    @Attribute(.unique) var id: String
    var title: String
    var note: String?
    var done: Bool
    var priority: String
    var dueAt: Date
    var estimate: Double

    init(id: String, title: String, note: String?, done: Bool, priority: String, dueAt: Date, estimate: Double) {
        self.id = id
        self.title = title
        self.note = note
        self.done = done
        self.priority = priority
        self.dueAt = dueAt
        self.estimate = estimate
    }
}

extension TodoEntity {
    convenience init(_ model: Todo) {
        self.init(id: model.id, title: model.title, note: model.note, done: model.done, priority: model.priority.rawValue, dueAt: model.dueAt, estimate: model.estimate)
    }

    var model: Todo {
        Todo(id: id, title: title, note: note, done: done, priority: Priority(rawValue: priority) ?? .low, dueAt: dueAt, estimate: estimate)
    }

    func update(from model: Todo) {
        title = model.title
        note = model.note
        done = model.done
        priority = model.priority.rawValue
        dueAt = model.dueAt
        estimate = model.estimate
    }
}
