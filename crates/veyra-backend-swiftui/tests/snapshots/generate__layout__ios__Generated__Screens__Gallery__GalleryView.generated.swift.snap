// This file is generated by Veyra, do not edit it manually

import SwiftUI

struct GalleryView<ViewModel: GalleryViewModelContract>: View {
    let viewModel: ViewModel

    var body: some View {
        VStack {
            ScrollView {
                LazyVGrid(columns: [GridItem(.adaptive(minimum: 120.0))], spacing: 8.0) {
                    ForEach(viewModel.state.photos, id: \.id) { photo in
                        Text(photo.title)
                    }
                }
            }
            .refreshable { await viewModel.reload() }
            .searchable(text: Binding(get: { viewModel.state.query }, set: { viewModel.setQuery($0) }), prompt: String("搜索"))
            ScrollView(.horizontal) {
                LazyHStack(spacing: 4.0) {
                    ForEach(viewModel.state.photos, id: \.id) { photo in
                        Text(photo.title)
                    }
                }
            }
            ScrollView {
                LazyVStack {
                    ForEach(viewModel.state.photos, id: \.id) { photo in
                        Text(photo.title)
                    }
                }
            }
            ScrollView(.horizontal, showsIndicators: false) {
                HStack {
                    Text(verbatim: "a")
                    Text(verbatim: "b")
                }
            }
            Form {
                Section {
                    Toggle(String("详情"), isOn: Binding(get: { viewModel.state.showDetails }, set: { viewModel.setShowDetails($0) }))
                } header: {
                    Text("基本")
                } footer: {
                    Text("说明")
                }
                GroupBox(String("分组")) {
                    Text(verbatim: "内容")
                }
                DisclosureGroup(String("更多"), isExpanded: Binding(get: { viewModel.state.showDetails }, set: { viewModel.setShowDetails($0) })) {
                    Text(verbatim: "展开内容")
                }
                DisclosureGroup(String("其他")) {
                    Text(verbatim: "本地状态")
                }
            }
        }
    }
}
