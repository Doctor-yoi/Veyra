// This file is generated by Veyra, do not edit it manually

import Foundation
import SwiftData

/// Data access for `Todo`
@MainActor
protocol TodoStore: AnyObject {
    func all() -> AsyncStream<[Todo]>
    func find(id: String) async throws -> Todo?
    func save(_ item: Todo) async throws
    func delete(id: String) async throws
    func pending() -> AsyncStream<[Todo]>
    func search(text: String, minimum: Priority) -> AsyncStream<[Todo]>
    func urgent(before: Date) async throws -> [Todo]
    func byTitle(name: String) async throws -> Todo?
}

/// SwiftData implementation of `TodoStore`
@MainActor
final class SwiftDataTodoStore: TodoStore {
    private let context: ModelContext

    init(context: ModelContext) {
        self.context = context
    }

    func all() -> AsyncStream<[Todo]> {
        observe(FetchDescriptor<TodoEntity>())
    }

    func find(id: String) async throws -> Todo? {
        try entity(id: id)?.model
    }

    func save(_ item: Todo) async throws {
        if let existing = try entity(id: item.id) {
            existing.update(from: item)
        } else {
            context.insert(TodoEntity(item))
        }
        try context.save()
    }

    func delete(id: String) async throws {
        if let existing = try entity(id: id) {
            context.delete(existing)
            try context.save()
        }
    }

    func pending() -> AsyncStream<[Todo]> {
        let descriptor = FetchDescriptor<TodoEntity>(predicate: #Predicate<TodoEntity> { entity in !(entity.done) }, sortBy: [SortDescriptor(\TodoEntity.dueAt, order: .forward), SortDescriptor(\TodoEntity.title, order: .forward)])
        return observe(descriptor)
    }

    func search(text: String, minimum: Priority) -> AsyncStream<[Todo]> {
        let minimumRaw = minimum.rawValue
        var descriptor = FetchDescriptor<TodoEntity>(predicate: #Predicate<TodoEntity> { entity in (entity.title.localizedStandardContains(text) && entity.priority == minimumRaw) || entity.note != nil })
        descriptor.fetchLimit = 20
        return observe(descriptor)
    }

    func urgent(before: Date) async throws -> [Todo] {
        let descriptor = FetchDescriptor<TodoEntity>(predicate: #Predicate<TodoEntity> { entity in (entity.dueAt < before && entity.priority == "high") && entity.estimate >= 1.0 }, sortBy: [SortDescriptor(\TodoEntity.dueAt, order: .reverse)])
        return try context.fetch(descriptor).map(\.model)
    }

    func byTitle(name: String) async throws -> Todo? {
        var descriptor = FetchDescriptor<TodoEntity>(predicate: #Predicate<TodoEntity> { entity in entity.title == name })
        descriptor.fetchLimit = 1
        return try context.fetch(descriptor).first?.model
    }

    private func entity(id: String) throws -> TodoEntity? {
        var descriptor = FetchDescriptor<TodoEntity>(predicate: #Predicate { $0.id == id })
        descriptor.fetchLimit = 1
        return try context.fetch(descriptor).first
    }

    private func observe(_ descriptor: FetchDescriptor<TodoEntity>) -> AsyncStream<[Todo]> {
        VeyraObservation.stream(context: context) { context in
            (try? context.fetch(descriptor))?.map(\.model) ?? []
        }
    }
}
