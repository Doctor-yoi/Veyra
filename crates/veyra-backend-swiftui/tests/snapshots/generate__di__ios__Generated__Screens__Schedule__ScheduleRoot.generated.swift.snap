import SwiftUI

/// Entry point of Schedule, creates the view model and injects dependencies
struct ScheduleRoot: View {
    @State private var viewModel = ScheduleViewModel()
    private let onEffect: (ScheduleEffect) -> Void

    /// `onEffect` handles one-off events such as navigation
    init(onEffect: @escaping (ScheduleEffect) -> Void = { _ in }) {
        self.onEffect = onEffect
    }

    var body: some View {
        ScheduleView(viewModel: viewModel)
            .onAppear { viewModel.onEffect = onEffect }
            .task { await viewModel.refresh() }
            .onDisappear { viewModel.stop() }
    }
}
