// This file is generated by Veyra, do not edit it manually

import SwiftUI

struct SettingsView<ViewModel: SettingsViewModelContract>: View {
    let viewModel: ViewModel

    var body: some View {
        Form {
            Picker(String("排序"), selection: Binding(get: { viewModel.state.order }, set: { viewModel.setOrder($0) })) {
                Text(verbatim: "名称")
                    .tag(SortOrder.title)
                Text(verbatim: "日期")
                    .tag(SortOrder.created)
            }
            .pickerStyle(.segmented)
            Picker(String("标签"), selection: Binding(get: { viewModel.state.tag }, set: { viewModel.setTag($0) })) {
                Text(verbatim: "无")
                    .tag(nil as String?)
                ForEach(viewModel.state.tags, id: \.id) { t in
                    Text(t.title)
                        .tag(Optional(t.id))
                }
            }
            Picker(String("方式"), selection: Binding(get: { viewModel.state.order }, set: { viewModel.setOrder($0) })) {
                Text(verbatim: "名称")
                    .tag(SortOrder.title)
                Text(verbatim: "日期")
                    .tag(SortOrder.created)
            }
            .pickerStyle(.inline)
            DatePicker(String("截止"), selection: Binding(get: { viewModel.state.due }, set: { viewModel.setDue($0) }), displayedComponents: [.date])
            DatePicker(String("提醒"), selection: Binding(get: { viewModel.state.due }, set: { viewModel.setDue($0) }))
            Stepper(String("数量"), value: Binding(get: { viewModel.state.count }, set: { viewModel.setCount($0) }), in: 1...10)
            Stepper(String("音量"), value: Binding(get: { viewModel.state.volume }, set: { viewModel.setVolume($0) }), in: 0.0...1.0, step: 0.1)
            TextEditor(text: Binding(get: { viewModel.state.notes }, set: { viewModel.setNotes($0) }))
            TextField(String("邮箱"), text: Binding(get: { viewModel.state.email }, set: { viewModel.setEmail($0) }))
                #if !os(macOS)
                .keyboardType(.emailAddress)
                #endif
                #if !os(macOS)
                .textInputAutocapitalization(.never)
                #endif
                .submitLabel(.done)
                .onSubmit { viewModel.submit() }
            Menu(String("更多")) {
                Button(String("保存")) {
                    Task { await viewModel.save() }
                }
                Divider()
                Button(String("重置"), role: .destructive) {
                    viewModel.reset()
                }
            }
            Link(String("帮助"), destination: URL(string: "https://example.com/help")!)
            Label(String("收藏"), systemImage: "star.fill")
            ForEach(viewModel.state.tags, id: \.id) { t in
                Label(t.title, systemImage: t.icon)
            }
            Gauge(value: viewModel.state.progress, in: 0.0...1.0) { Text(verbatim: "进度") }
            ProgressView(String("加载"), value: viewModel.state.progress, total: 1.0)
                .progressViewStyle(.circular)
            Button(String("取消"), role: .cancel) {
                viewModel.reset()
            }
        }
    }
}
