// This file is generated by Veyra, do not edit it manually

import Foundation

/// Credentials of `Account`, values are nil until written
@MainActor
protocol Account: AnyObject {
    func token() throws -> String?
    func setToken(_ value: String?) throws
    func userId() throws -> Int?
    func setUserId(_ value: Int?) throws
    func remember() throws -> Bool?
    func setRemember(_ value: Bool?) throws
}

/// Keychain implementation of `Account`
@MainActor
final class KeychainAccount: Account {
    private let keychain: VeyraKeychain

    /// Items are stored under the bundle identifier followed by the declaration name
    init(service: String = (Bundle.main.bundleIdentifier ?? "veyra") + ".Account") {
        keychain = VeyraKeychain(service: service)
    }

    func token() throws -> String? {
        try keychain.read("token")
    }

    func setToken(_ value: String?) throws {
        try keychain.write("token", value)
    }

    func userId() throws -> Int? {
        try keychain.read("userId").flatMap { Int($0) }
    }

    func setUserId(_ value: Int?) throws {
        try keychain.write("userId", value.map { String($0) })
    }

    func remember() throws -> Bool? {
        try keychain.read("remember").map { $0 == "true" }
    }

    func setRemember(_ value: Bool?) throws {
        try keychain.write("remember", value.map { String($0) })
    }
}
