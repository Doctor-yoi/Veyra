import SwiftUI

struct SearchBar: View {
    @Binding var text: String
    let placeholder: String

    var body: some View {
        HStack(spacing: 8.0) {
            Image("search")
            TextField(placeholder, text: $text)
        }
    }
}

struct CourseCard: View {
    let course: Course
    let note: String?
    let onTap: () -> Void

    var body: some View {
        VStack(alignment: .leading) {
            Text(course.name)
                .font(.headline)
            Text(note ?? "")
                .foregroundStyle(.secondary)
        }
        .onTapGesture { onTap() }
    }
}
