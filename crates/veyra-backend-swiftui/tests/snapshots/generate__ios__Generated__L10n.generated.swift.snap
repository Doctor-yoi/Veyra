        String(localized: "schedule.refresh", defaultValue: "刷新", table: "Veyra")
    }

    /// 搜索课程
    static var scheduleSearch: String {
        String(localized: "schedule.search", defaultValue: "搜索课程", table: "Veyra")
    }

    /// 我的课表
    static var scheduleTitle: String {
        String(localized: "schedule.title", defaultValue: "我的课表", table: "Veyra")
    }
}
