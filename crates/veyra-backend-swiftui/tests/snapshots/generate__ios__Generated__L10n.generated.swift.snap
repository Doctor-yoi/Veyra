    /// 共{count}门课程，筛选：{filter}
    static func scheduleCount(count: Int, filter: String) -> String {
        String(localized: "schedule.count", defaultValue: "共\(count)门课程，筛选：\(filter)", table: "Veyra")
    }

    /// 暂无课程
    static var scheduleEmpty: String {
        String(localized: "schedule.empty", defaultValue: "暂无课程", table: "Veyra")
    }

