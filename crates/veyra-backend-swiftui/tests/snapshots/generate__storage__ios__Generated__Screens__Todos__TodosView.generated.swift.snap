// This file is generated by Veyra, do not edit it manually

import SwiftUI

struct TodosView<ViewModel: TodosViewModelContract>: View {
    let viewModel: ViewModel

    var body: some View {
        List(viewModel.state.items, id: \.id) { task in
            HStack {
                Text(task.title)
                Spacer()
                Text(task.done ? "✓" : "")
            }
            .onTapGesture { Task { await viewModel.toggle(id: task.id) } }
        }
    }
}
