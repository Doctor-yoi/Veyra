// This file is generated by Veyra, do not edit it manually

package com.example.tasks

import android.content.Context

/** Credentials of `Account`, values are null until written */
interface Account {
    suspend fun token(): String?
    suspend fun setToken(value: String?)
    suspend fun userId(): Int?
    suspend fun setUserId(value: Int?)
    suspend fun remember(): Boolean?
    suspend fun setRemember(value: Boolean?)
}

/** Implementation of `Account` encrypted with an Android Keystore key */
class KeystoreAccount(context: Context) : Account {
    private val vault = VeyraVault(context, "account")

    override suspend fun token(): String? = vault.read("token")

    override suspend fun setToken(value: String?) = vault.write("token", value)

    override suspend fun userId(): Int? = vault.read("userId")?.toIntOrNull()

    override suspend fun setUserId(value: Int?) = vault.write("userId", value?.toString())

    override suspend fun remember(): Boolean? = vault.read("remember")?.toBooleanStrictOrNull()

    override suspend fun setRemember(value: Boolean?) = vault.write("remember", value?.toString())
}
