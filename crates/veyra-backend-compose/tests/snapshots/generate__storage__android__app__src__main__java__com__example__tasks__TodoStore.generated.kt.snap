// This file is generated by Veyra, do not edit it manually

package com.example.tasks

import androidx.room.Dao
import androidx.room.Query
import androidx.room.Upsert
import java.time.Instant
import kotlinx.coroutines.flow.Flow
import kotlinx.coroutines.flow.map

@Dao
interface TodoStoreDao {
    @Query("SELECT * FROM todo")
    fun all(): Flow<List<TodoEntity>>

    @Query("SELECT * FROM todo WHERE id = :id LIMIT 1")
    suspend fun find(id: String): TodoEntity?

    @Upsert
    suspend fun save(entity: TodoEntity)

    @Query("DELETE FROM todo WHERE id = :id")
    suspend fun delete(id: String)

    @Query("SELECT * FROM todo WHERE NOT (done = 1) ORDER BY dueAt ASC, title ASC")
    fun pending(): Flow<List<TodoEntity>>

    @Query("SELECT * FROM todo WHERE ((title LIKE '%' || :text || '%' AND priority = :minimum) OR note IS NOT NULL) LIMIT 20")
    fun search(text: String, minimum: Priority): Flow<List<TodoEntity>>

    @Query("SELECT * FROM todo WHERE ((dueAt < :before AND priority = 'high') AND estimate >= 1.0) ORDER BY dueAt DESC")
    suspend fun urgent(before: Instant): List<TodoEntity>

    @Query("SELECT * FROM todo WHERE title = :name LIMIT 1")
    suspend fun byTitle(name: String): TodoEntity?
}

/** Data access for `Todo` */
interface TodoStore {
    fun all(): Flow<List<Todo>>
    suspend fun find(id: String): Todo?
    suspend fun save(item: Todo)
    suspend fun delete(id: String)
    fun pending(): Flow<List<Todo>>
    fun search(text: String, minimum: Priority): Flow<List<Todo>>
    suspend fun urgent(before: Instant): List<Todo>
    suspend fun byTitle(name: String): Todo?
}

/** Room implementation of `TodoStore` */
class RoomTodoStore(private val dao: TodoStoreDao) : TodoStore {
    override fun all(): Flow<List<Todo>> = dao.all().map { rows -> rows.map { it.toModel() } }
    override suspend fun find(id: String): Todo? = dao.find(id)?.toModel()
    override suspend fun save(item: Todo) = dao.save(item.toEntity())
    override suspend fun delete(id: String) = dao.delete(id)
    override fun pending(): Flow<List<Todo>> = dao.pending().map { rows -> rows.map { it.toModel() } }
    override fun search(text: String, minimum: Priority): Flow<List<Todo>> = dao.search(text, minimum).map { rows -> rows.map { it.toModel() } }
    override suspend fun urgent(before: Instant): List<Todo> = dao.urgent(before).map { it.toModel() }
    override suspend fun byTitle(name: String): Todo? = dao.byTitle(name)?.toModel()
}
