// This file is generated by Veyra, do not edit it manually

package com.example.schedule.ui

/** UI state of Schedule, updated only by the view model */
data class ScheduleUiState(
    val query: String = "",
    val items: List<Course> = emptyList(),
    val isRefreshing: Boolean = false,
    val volume: Double = 0.5,
    val notify: Boolean = true,
    val password: String = "",
) {
    val count: Int
        get() = items.size

    val canRefresh: Boolean
        get() = !isRefreshing && count >= 0

    val subtitle: String
        get() = if (query.isEmpty()) "全部" else query
}

/** Commands that the Schedule view can dispatch */
interface ScheduleActions {
    fun setQuery(value: String)
    fun setVolume(value: Double)
    fun setNotify(value: Boolean)
    fun setPassword(value: String)
    fun refresh()
    fun openCourse(id: String)
    fun stop()
}

/** One-off events emitted by the Schedule view model */
sealed interface ScheduleEffect {
    data class NavigateToDetail(val id: String) : ScheduleEffect
    data class ShowToast(val message: String) : ScheduleEffect
    data object Close : ScheduleEffect
}
