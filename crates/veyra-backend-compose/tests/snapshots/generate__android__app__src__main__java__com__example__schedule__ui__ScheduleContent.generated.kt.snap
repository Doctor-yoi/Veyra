@Composable
fun ScheduleContent(
    state: ScheduleUiState,
    actions: ScheduleActions,
    modifier: Modifier = Modifier,
) {
    Column(
        modifier = modifier.verticalScroll(rememberScrollState()),
        horizontalAlignment = Alignment.CenterHorizontally,
    ) {
        Column(verticalArrangement = Arrangement.spacedBy(16.0.dp), horizontalAlignment = Alignment.Start) {
            Text(
                text = stringResource(R.string.schedule_title),
                style = MaterialTheme.typography.headlineMedium,
                modifier = Modifier.padding(8.0.dp),
            )
            Text(
                text = stringResource(R.string.schedule_count, state.count, state.subtitle),
                color = MaterialTheme.colorScheme.onSurfaceVariant,
            )
            OutlinedTextField(
                value = state.query,
                onValueChange = { actions.setQuery(it) },
                label = { Text(text = stringResource(R.string.schedule_search)) },
            )
            SearchBar(text = state.query, onTextChange = { actions.setQuery(it) }, placeholder = "搜索")
            FloatingActionButton(onClick = { actions.refresh() }, modifier = Modifier.testTag("fab")) {
                Text(text = "+")
            }
            Text(text = state.query)
            if (BuildConfig.DEBUG) {
                Text(text = "debug build")
            } else {
                Text(text = "release build")
            }
            Text(
                text = "tag",
                modifier = Modifier.background(Color.Blue).then(if (BuildConfig.DEBUG) Modifier.padding(4.0.dp) else Modifier),
            )
            OutlinedTextField(
                value = state.password,
                onValueChange = { actions.setPassword(it) },
                label = { Text(text = "密码") },
                visualTransformation = PasswordVisualTransformation(),
            )
            Row(verticalAlignment = Alignment.CenterVertically) {
                Text(text = stringResource(R.string.schedule_notify), modifier = Modifier.weight(1f))
                Switch(checked = state.notify, onCheckedChange = { actions.setNotify(it) })
            }
            Slider(
                value = state.volume.toFloat(),
                onValueChange = { actions.setVolume(it.toDouble()) },
                valueRange = 0.0f..1.0f,
            )
            Text(text = veyraFormatPercent(state.volume))
            Text(text = pluralStringResource(R.plurals.schedule_items, state.count, state.count))
            Button(
                onClick = { actions.refresh() },
                enabled = state.canRefresh,
                modifier = Modifier.fillMaxWidth(),
            ) {
                Text(text = stringResource(R.string.schedule_refresh))
            }
            if (state.isRefreshing) {
                CircularProgressIndicator()
            } else if (state.items.isEmpty()) {
                Text(text = stringResource(R.string.schedule_empty))
            } else {
                state.items.forEach { course ->
                    key(course.id) {
                        val label0 = course.name
                        Row(
                            modifier = Modifier.semantics { contentDescription = label0 }.clickable { actions.openCourse(id = course.id) }.background(MaterialTheme.colorScheme.primary).padding(16.dp),
                            verticalAlignment = Alignment.CenterVertically,
                        ) {
                            Image(painter = painterResource(id = R.drawable.book), contentDescription = null)
                            Text(text = course.name, style = MaterialTheme.typography.titleMedium)
                            Text(text = veyraFormatNumber(course.credits))
                            Text(text = veyraFormatDate(course.startsAt, date = FormatStyle.SHORT, time = FormatStyle.SHORT))
                            Text(text = veyraFormatCurrency(course.credits, "CNY"))
                            Spacer(modifier = Modifier.weight(1f))
                            Text(text = course.teacher ?: "-", color = Color.Gray)
                        }
                    }
                }
            }
            state.items.forEach { course ->
                key(course.id) {
                    CourseCard(course = course, note = null, onTap = { actions.openCourse(id = course.id) })
                }
            }
            HorizontalDivider()
            Box(contentAlignment = Alignment.BottomEnd) {
                Text(text = "v1.0", modifier = Modifier.alpha(if (state.isRefreshing) 0f else 1f))
            }
        }
    }
}
