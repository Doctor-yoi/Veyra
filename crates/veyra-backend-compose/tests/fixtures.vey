enum CourseKind { lecture, lab }

model Course {
  id: String
  name: String
  credits: Double
  kind: CourseKind
  teacher: String?
  startsAt: Date
}

repository CourseRepository {
  getCourses() async throws -> List<Course>
  observeCourses() -> Stream<List<Course>>
}

component SearchBar(text: Binding<String>, placeholder: String) {
  Row(spacing: 8) {
    Image("search")
    TextField(placeholder, text: text)
  }
}

component CourseCard(course: Course, note: String?, onTap: Action) {
  Column(alignment: .leading) {
    Text(course.name).font(.headline)
    Text(note ?? "").foreground(.secondary)
  }
  .onTap(onTap)
}

screen Schedule {
  inject courses: CourseRepository

  state {
    query: String = "" @writable
    items: List<Course> = []
    isRefreshing: Bool = false
    volume: Double = 0.5 @writable
    notify: Bool = true @writable
    password: String = "" @writable
    cardWidth: Double? = nil
  }

  computed {
    count: Int = items.count
    canRefresh: Bool = !isRefreshing && count >= 0
    subtitle: String = query.isEmpty ? "全部" : query
  }

  actions {
    refresh() async
    openCourse(id: String)
    stop()
  }

  effects {
    navigateToDetail(id: String)
    showToast(message: String)
    close
  }

  lifecycle {
    onAppear: refresh
    onDisappear: stop
  }

  view {
    ScrollView {
      Column(spacing: 16, alignment: .leading) {
        Text(loc("schedule.title", "我的课表")).font(.title).padding(8)
        Text(loc("schedule.count", "共{count}门课程，筛选：{filter}", count: count, filter: subtitle))
          .foreground(.secondary)
        TextField(loc("schedule.search", "搜索课程"), text: bind(query))
        SearchBar(text: bind(query), placeholder: "搜索")
        #if ios
        swiftui.ShareLink(loc("schedule.share", "分享"), item: query)
        native swiftui {
          """
          Text(verbatim: {{query}}).monospaced()
          Button("Native") { Task { await {{refresh}}() } }
          """
        }
        #elseif android
        compose.FloatingActionButton("+", action: refresh)
          .compose.testTag("fab")
        native compose {
          """
          Text(text = {{query}})
          """
        }
        #endif
        #if debug
        Text("debug build")
        #else
        Text("release build")
        #endif
        #if apple
        if available(ios: 26) {
          Text("glass").swiftui.glassEffect(.regular, in: .capsule)
        } else {
          Text("plain")
        }
        swiftui.Menu(loc("schedule.more", "更多")) {
          Button(loc("schedule.refresh", "刷新"), action: refresh)
        }
        swiftui.Section(header: { Text("头部") }) {
          Text("内容")
        }
        swiftui.Stepper("音量", value: bind(volume), step: 0.1)
        swiftui.Link("Veyra", destination: "https://github.com/Doctor-yoi/Veyra")
        swiftui.ContentUnavailableView(loc("schedule.none", "没有内容"), systemImage: "tray")
        Text(query)
          .swiftui.textInputAutocapitalization(.never)
          .swiftui.foregroundStyle(.tint)
          .swiftui.refreshable(action: refresh)
          .swiftui.navigationTitle(loc("schedule.title", "我的课表"))
          .swiftui.frame(width: cardWidth)
        #endif
        Text("tag")
          #if debug
          .padding(4)
          #endif
          .background(.blue)
        SecureField("密码", text: bind(password))
        Toggle(loc("schedule.notify", "上课提醒"), isOn: bind(notify))
        Slider(value: bind(volume), min: 0, max: 1)
        Text(format(volume, .percent))
        Text(plural("schedule.items", count, other: "{count}门课"))
        Button(loc("schedule.refresh", "刷新"), action: refresh)
          .disabled(!canRefresh)
          .frame(maxWidth: .infinity)
        if isRefreshing {
          Progress()
        } else if items.isEmpty {
          Text(loc("schedule.empty", "暂无课程"))
        } else {
          ForEach(items, key: .id) { course in
            Row(alignment: .center) {
              Image("book")
              Text(course.name).font(.headline)
              Text(format(course.credits, .number))
              Text(format(course.startsAt, .dateTime(.short)))
              Text(format(course.credits, .currency("CNY")))
              Spacer()
              Text(course.teacher ?? "-").foreground(.gray)
            }
            .padding()
            .background(.accent)
            .onTap(openCourse(course.id))
            .accessibilityLabel(course.name)
          }
        }
        ForEach(items, key: .id) { course in
          CourseCard(course: course, onTap: openCourse(course.id))
        }
        Divider()
        Stack(alignment: .bottomTrailing) {
          Text("v1.0").hidden(isRefreshing)
        }
      }
    }
  }
}

screen About {
  view {
    Text("Veyra")
  }
}
