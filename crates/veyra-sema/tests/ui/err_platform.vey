// 平台扩展
screen Home {
  state {
    title: String = ""
  }
  actions {
    go()
  }
  view {
    Column {
      swiftui.ShareLink("分享", item: title)
      #if apple
      swiftui.Unknown()
      Text("x").swiftui.blur()
      ios.ShareLink("旧写法", item: title)
      #endif
      windows.Button()
      Text("x")
        #if debug
        .font(.title)
        #endif
      #if apple
      native swiftui {
        """
        Text({{missing}}) {{go}} {{title.count}} {{a b}}
        """
      }
      #endif
    }
  }
}

screen Settings {
  #if ios
  inject repo: Repo
  #endif
  view {
    Text("x")
  }
}

repository Repo {
  load() async
}

#if macos
model MacOnly { a: Int }
#endif
