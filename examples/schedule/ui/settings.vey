// 设置页

screen Settings {
  state {
    reminder: Bool = true @writable
    volume: Double = 0.6 @writable
    nickname: String = "" @writable
  }

  actions {
    save() async
  }

  view {
    Column(spacing: 16) {
      Text(loc("settings.title", "设置")).font(.title)
      Toggle(loc("settings.reminder", "上课提醒"), isOn: bind(reminder))
      Slider(value: bind(volume), min: 0, max: 1)
      TextField(loc("settings.nickname", "昵称"), text: bind(nickname))
      Button(loc("settings.save", "保存"), action: save)
        .frame(maxWidth: .infinity)
    }
    .padding()
  }
}
