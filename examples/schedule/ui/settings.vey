// 设置页：偏好设置与登录凭证

settings AppPreferences {
  reminder: Bool = true
  volume: Double = 0.6
  nickname: String = ""
}

secure Account {
  token: String
}

screen Settings {
  inject preferences: AppPreferences
  inject account: Account

  state {
    reminder: Bool = true @writable
    volume: Double = 0.6 @writable
    nickname: String = "" @writable
    signedIn: Bool = false
  }

  actions {
    load() async
    save() async
    signOut() async
  }

  lifecycle {
    onAppear: load
  }

  view {
    Column(spacing: 16) {
      Text(loc("settings.title", "设置")).font(.title)
      Toggle(loc("settings.reminder", "上课提醒"), isOn: bind(reminder))
        .padding(12)
        #if ios
        .ios.glassEffect()
        #endif
      Slider(value: bind(volume), min: 0, max: 1)
      TextField(loc("settings.nickname", "昵称"), text: bind(nickname))
        .padding(12)
        #if ios
        .ios.glassEffect()
        #endif
      Button(loc("settings.save", "保存"), action: save)
        .frame(maxWidth: .infinity)
        .padding(12)
        #if ios
        .ios.glassEffect()
        #endif
      if signedIn {
        Button(loc("settings.sign_out", "退出登录"), action: signOut)
          .padding(12)
          #if ios
          .ios.glassEffect()
          #endif
      }
    }
    .padding()
  }
}
