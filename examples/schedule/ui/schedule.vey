// 课表页：搜索、刷新与课程列表

component CourseRow(course: Course, onTap: Action) {
  Row(spacing: 8) {
    Text(course.name).font(.headline)
    Spacer()
    Text(format(course.credits, .number))
    Text(course.teacher ?? "-").foreground(.secondary)
  }
  .onTap(onTap)
}

screen Schedule {
  inject courses: CourseRepository

  state {
    query: String = "" @writable
    items: List<Course> = []
    isRefreshing: Bool = false
    errorMessage: String? = nil
    #if ios
    compact: Bool = false @writable
    #endif
  }

  computed {
    count: Int = items.count
    canRefresh: Bool = !isRefreshing
  }

  actions {
    refresh() async
    openCourse(id: String)
  }

  effects {
    showCourse(id: String)
  }

  lifecycle {
    onAppear: refresh
  }

  view {
    Column(spacing: 12, alignment: .leading) {
      Text(loc("schedule.title", "我的课表")).font(.largeTitle)
      Text(plural("schedule.count", count, other: "共{count}门课程")).foreground(.secondary)
      TextField(loc("schedule.search", "搜索课程"), text: bind(query))
      #if ios
      Toggle(loc("schedule.compact", "紧凑模式"), isOn: bind(compact))
      #endif
      Button(loc("schedule.refresh", "刷新"), action: refresh)
        .disabled(!canRefresh)
      if isRefreshing {
        Progress()
      } else if items.isEmpty {
        Text(errorMessage ?? "").foreground(.red)
        Text(loc("schedule.empty", "暂无课程")).foreground(.secondary)
      } else {
        List(items, key: .id) { course in
          CourseRow(course: course, onTap: openCourse(course.id))
        }
      }
      #if premium
      Text(loc("schedule.premium", "高级版")).foreground(.accent)
      #endif
    }
    .padding(16)
  }
}
